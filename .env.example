# Database
# Local dev (SQLite — no setup needed):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL — use Neon for Vercel):
# DATABASE_URL="postgresql://user:pass@ep-xxxxx.us-east-2.aws.neon.tech/dropbot?sslmode=require"
# For production, also swap prisma/schema.prisma with prisma/schema.postgres.prisma

# NextAuth v5
AUTH_SECRET="your-secret-at-least-32-chars"
AUTH_URL="http://localhost:3000"

# Seed password (optional — defaults to "password123")
# SEED_PASSWORD="password123"

# OpenAI (optional — for AI-powered chatbot responses)
OPENAI_API_KEY=""

# Stripe (optional — for payments)
STRIPE_SECRET_KEY=""
STRIPE_PRO_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
