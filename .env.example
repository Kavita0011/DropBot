# Database (SQLite - no setup needed for local dev)
DATABASE_URL="file:./dev.db"

# NextAuth v5 - generate with: npx auth secret
AUTH_SECRET="your-secret-at-least-32-chars"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional - for social login)
# Get credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI (optional - for AI-powered chatbot responses)
# Get key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Stripe (optional - for payments)
# Get keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PRO_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""
# Get from Stripe CLI: stripe listen --forward-to localhost:3000/api/webhook/stripe
STRIPE_WEBHOOK_SECRET=""

# App URL - change to your Vercel domain in production
NEXT_PUBLIC_APP_URL="http://localhost:3000"
