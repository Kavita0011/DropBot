# Database (PostgreSQL - recommended: Neon for Vercel, or local instance)
# For Neon: create free DB at https://neon.tech, copy the connection string here
# For local: postgresql://postgres:password@localhost:5432/dropbot
DATABASE_URL="postgresql://postgres:password@localhost:5432/dropbot"

# NextAuth v5
AUTH_SECRET="your-secret-at-least-32-chars"
AUTH_URL="http://localhost:3000"

# OpenAI (optional - for AI-powered chatbot responses)
# Get key at https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# Stripe (optional - for payments)
# Get keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_PRO_PRICE_ID=""
STRIPE_BUSINESS_PRICE_ID=""
# Get from Stripe CLI: stripe listen --forward-to localhost:3000/api/webhook/stripe
STRIPE_WEBHOOK_SECRET=""

# App URL - change to your Vercel domain in production
NEXT_PUBLIC_APP_URL="http://localhost:3000"
